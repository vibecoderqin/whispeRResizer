{
  "manifest_version": 3,
  "name": "Twitch Whisper Resizer",
  "version": "1.0.0",
  "description": "Делает окно шёпотов (whispers) на Twitch растягиваемым — тяни за угол!",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["*://www.twitch.tv/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
