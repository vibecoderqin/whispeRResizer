{
  "manifest_version": 3,
  "name": "Twitch Whisper Resizer",
  "version": "1.1.0",
  "description": "Resize open Twitch whisper conversations and remember dimensions per user.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://www.twitch.tv/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
